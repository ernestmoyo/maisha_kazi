# ── Database ──────────────────────────────────────────────────────────────────
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB in docker-compose.prod.yml
DATABASE_URL=postgresql://maisha:CHANGE_ME@postgres:5432/maisha_kazi

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate strong random strings: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_STRONG_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_STRONG_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# The public URL of the frontend (used by CORS)
# Set to your domain, e.g. https://maishakazi.org
CLIENT_URL=http://localhost

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=5

# ── Email (optional — leave blank to disable email features) ──────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@maishakazi.org
